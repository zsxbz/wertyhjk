# =====================

@app.route("/create", methods=["GET", "POST"])
def create_server():

    if request.method == "POST":

        name = request.form.get("name")

        if not name:
            return "Server name required"


        # 不正な名前を防止
        if "/" in name or "\\" in name or ".." in name:
            return "Invalid name"


        server_path = os.path.join(
            ROOT,
            name
        )


        # 既に存在
        if os.path.exists(server_path):
            return "Already exists"


        # フォルダ作成
        os.makedirs(server_path)


        # index.html作成
        with open(
            os.path.join(server_path, "index.html"),
            "w",
            encoding="utf-8"
        ) as f:

            f.write(
                "<h1>"+name+"</h1>"
            )


        # main.py作成
        with open(
            os.path.join(server_path, "main.py"),
            "w",
            encoding="utf-8"
        ) as f:

            f.write(
                'print("Server started")'
            )


        return """
        <h2>Created!</h2>
        <p>Server: %s</p>
        <a href="/panel">Panel</a>
        """ % name


    # GETの場合
    return """
    <!DOCTYPE html>
    <html>
    <head>
    <meta charset="utf-8">
    <title>Create Server</title>
    </head>

    <body>

    <h1>Create Server</h1>

    <form method="post" action="/create">

        <input
        type="text"
        name="name"
        placeholder="Server name">

        <button type="submit">
        Create
        </button>

    </form>

    </body>
    </html>
    """
