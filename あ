@app.route("/")
@app.route("/panel")
def panel():

    servers = []

    if os.path.exists(ROOT):

        servers = os.listdir(ROOT)

    return render_template(
        "index.html",
        servers=servers
    )



<h2>Servers</h2>

{% for server in servers %}

<div>
📁 {{server}}

<a href="/{{server}}/index.html">
開く
</a>

<a href="/panel/{{server}}">
管理
</a>

</div>

{% endfor %}
